# Runtime PostgreSQL connection. For Supabase, use the transaction pooler URL
# (port 6543) and append `?pgbouncer=true&connection_limit=1`.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct PostgreSQL connection used only by Prisma migration/introspection tools.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_TRUST_HOST="true"

# Required only while running the idempotent seed command.
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_LEARNER_EMAIL=""
SEED_LEARNER_PASSWORD=""

# AI is optional. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
AI_PROVIDER="openai"

UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="5242880"
